# Variables de ejemplo para desarrollo local

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=pasajes_db
MYSQL_USER=pasajes_app
MYSQL_PASSWORD=cambia_esta_clave_app

# Conexion del backend a MySQL desde el equipo local
DATABASE_URL=mysql+pymysql://pasajes_app:cambia_esta_clave_app@localhost:3306/pasajes_db

# Direccion de la API para Vue
VITE_API_URL=http://localhost:8000

# Clave JWT de ejemplo; reemplazar por un secreto aleatorio propio
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

#Usar datos simulados
VITE_USE_MOCKS=true